# Create a dedicated bot with @BotFather. Keep its token out of Git.
TELEGRAM_BOT_TOKEN=
# Required; comma-separated numeric Telegram user IDs. Private chats only.
ALLOWED_USER_IDS=

WHISPER_MODEL_PATH=models/ggml-large-v3-turbo.bin
WHISPER_BINARY=whisper-cli
FFMPEG_BINARY=ffmpeg
WHISPER_LANGUAGE=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
SUMMARY_LANGUAGE=auto
DATA_DIR=data
# Deployment ceiling and default; each user can choose /limit 5 or /limit 10.
MAX_DURATION_SECONDS=600
MAX_FILE_BYTES=20000000
MAX_PENDING_JOBS=10
TRANSCRIPT_TTL_HOURS=24
